# ── Base de données PostgreSQL (Supabase) ──────────────────────────
# Supabase necessite ?sslmode=require pour les connexions SSL
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# ── Sécurité ────────────────────────────────────────────────────────
SECRET_KEY=changez_cette_cle_secrete_en_production

# ── MediaPipe ───────────────────────────────────────────────────────
MODEL_PATH=pose_landmarker_full.task
MIN_CONFIDENCE=0.3

# ── Cloudinary (suppression des images après traitement) ────────────
# Ces clés sont nécessaires pour supprimer les images après le scan.
# API Key et Secret disponibles dans le Dashboard Cloudinary > Settings > Security
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Environnement ───────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
